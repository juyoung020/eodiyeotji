<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어가는 것. 릴리즈 APK에는 없다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 시연용 1년치 기록 넣기 (사용법은 record/DemoSeedReceiver.kt) -->
        <receiver
            android:name=".record.DemoSeedReceiver"
            android:exported="true" />

        <!-- 열려 있는 검색 칸에 말 넣기 (사용법은 ui/search/SearchDebugReceiver.kt) -->
        <receiver
            android:name=".ui.search.SearchDebugReceiver"
            android:exported="true" />

        <!-- 기억 에이전트 화면만 띄워 보기 (실제 기억 에이전트, 사용법은 ui/agent/AgentDebugActivity.kt).
             주행 화면도 확인하므로 주행 중 사용 화면(DO)으로 선언한다. -->
        <activity
            android:name=".ui.agent.AgentDebugActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
