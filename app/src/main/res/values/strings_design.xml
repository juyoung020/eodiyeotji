<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 화면 디자인 (ui/timeline 머리 · 통계 칸 · 상태 화면). 기존 문구는 strings_timeline.xml -->

    <!-- 하루 상세 통계 칸: 위는 값, 아래는 이름 -->
    <string name="home_year">%1$d년</string>
    <string name="home_month">%1$d월</string>
    <string name="home_latest_day">최근으로</string>
    <string name="home_all_timeline">전체 시간표</string>
    <string name="home_all_timeline_close">시간표 닫기</string>
    <string name="home_close_timeline">시간표 닫기</string>
    <string name="stat_more">통계 더 보기</string>
    <string name="stat_less">통계 접기</string>
    <string name="stat_trips_label">주행</string>
    <!-- 들른 곳 = 하루 출발 · 도착(대개 집)을 뺀 머문 곳 (Rust visit_count, 그날로 돌아가기와 같은 값) -->
    <string name="stat_stays_label">들른 곳</string>
    <string name="stat_distance_label">거리</string>
    <string name="stat_drive_label">운전 시간</string>
    <string name="stat_people_value">%1$d명</string>
    <string name="stat_people_label">탄 사람</string>
    <string name="stat_energy_value">%1$d%%</string>
    <string name="stat_energy_ev_label">쓴 배터리</string>
    <string name="stat_energy_fuel_label">쓴 연료</string>
    <string name="stat_rain_value">비</string>
    <string name="stat_rain_label">날씨</string>
    <string name="stat_trips_value">%1$d회</string>
    <string name="stat_stays_value">%1$d곳</string>

    <!-- 목록 행 왼쪽 날짜 타일: 일(숫자) 아래 요일. java.time 패턴 -->
    <string name="day_tile_weekday_pattern" translatable="false">E</string>
    <!-- 하루 상세 제목. 예: 11월 5일 목요일 -->
    <string name="day_title_pattern" translatable="false">M월 d일 EEEE</string>
    <string name="day_title_pattern_year" translatable="false">yyyy년 M월 d일 EEEE</string>
    <!-- 날짜 목록 행 제목 (요일은 왼쪽 타일에 있다). 예: 11월 4일 -->
    <string name="day_list_pattern" translatable="false">M월 d일</string>
    <string name="day_list_pattern_year" translatable="false">yyyy년 M월 d일</string>

    <!-- 좁은 창 상세의 뒤로 버튼 (아이콘만 보이고 읽어 주기용) -->
    <string name="timeline_back_description">날짜 목록으로 돌아가기</string>
    <!-- 아직 머무는 곳 표시 -->
    <string name="entry_here">지금 여기</string>
    <string name="entry_now">지금</string>
    <!-- 항목 시각 열 아래 칸: 끝난 시각. 위 칸 시작 시각과 이어 읽히게 "09:18 / –09:32" (시각 열이 좁아 두 줄로 나눈다) -->
    <string name="entry_until">–%1$s</string>

    <!-- 하루 태그 알약. 예: #여행 -->
    <string name="day_tag">#%1$s</string>

    <string name="timeline_failed_title">기록을 불러오지 못했어요</string>
    <string name="timeline_list_title">날짜별 기록</string>
    <string name="timeline_back_to_today">↑ 오늘로</string>
</resources>
