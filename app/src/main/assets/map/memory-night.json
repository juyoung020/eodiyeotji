{
  "version": 8,
  "name": "eodi-memory-night",
  "metadata": {"comment": "기억 지도 스타일 (ui/memorymap/MemoryMapScreen.kt가 읽는다). 밤하늘 같은 남색 바탕 + 아주 옅은 물·큰길(OpenFreeMap, 없으면 바탕만) 위에 Rust memory_map의 경로(__ROUTES__)를 금빛으로 번지게, 자주 간 곳(__VISITS__)을 별처럼 그린다. 경로·별의 filter는 앱이 달(m)마다 바꿔 차례로 드러낸다."},
  "sources": {
    "ofm": {"type": "vector", "url": "https://tiles.openfreemap.org/planet", "attribution": "© OpenFreeMap © OpenMapTiles © OpenStreetMap"},
    "routes": {"type": "geojson", "data": "__ROUTES__"},
    "visits": {"type": "geojson", "data": "__VISITS__"}
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#070D1C"}},
    {"id": "water", "type": "fill", "source": "ofm", "source-layer": "water", "paint": {"fill-color": "#04091A", "fill-opacity": 0.9}},
    {"id": "boundary", "type": "line", "source": "ofm", "source-layer": "boundary",
     "filter": ["<=", ["get", "admin_level"], 4],
     "paint": {"line-color": "#1B2747", "line-width": 0.8, "line-dasharray": [2, 3], "line-opacity": 0.6}},
    {"id": "roads", "type": "line", "source": "ofm", "source-layer": "transportation",
     "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
     "paint": {"line-color": "#121C35", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 12, 1.4]}},
    {"id": "route-haze", "type": "line", "source": "routes", "filter": ["<=", ["get", "m"], -1],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#FF9E2C", "line-opacity": 0.10,
               "line-width": ["interpolate", ["linear"], ["zoom"], 5, 6, 12, 18],
               "line-blur": ["interpolate", ["linear"], ["zoom"], 5, 5, 12, 14]}},
    {"id": "route-glow", "type": "line", "source": "routes", "filter": ["<=", ["get", "m"], -1],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#FFC15E", "line-opacity": 0.22,
               "line-width": ["interpolate", ["linear"], ["zoom"], 5, 2.2, 12, 6],
               "line-blur": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 12, 4]}},
    {"id": "route-core", "type": "line", "source": "routes", "filter": ["<=", ["get", "m"], -1],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#FFE7B0", "line-opacity": 0.35,
               "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 12, 1.4]}},
    {"id": "route-fresh", "type": "line", "source": "routes", "filter": ["==", ["get", "m"], -1],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#FFF6DD", "line-opacity": 0.75,
               "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.6, 12, 3.5],
               "line-blur": ["interpolate", ["linear"], ["zoom"], 5, 1.0, 12, 2.5]}},
    {"id": "visit-halo", "type": "circle", "source": "visits", "filter": ["<=", ["get", "m"], -1],
     "paint": {"circle-color": "#FFB547",
               "circle-radius": ["*", ["interpolate", ["linear"], ["zoom"], 5, 1.0, 12, 2.4], ["+", 4, ["*", 22, ["get", "w"]]]],
               "circle-blur": 1, "circle-opacity": ["+", 0.08, ["*", 0.42, ["get", "w"]]]}},
    {"id": "visit-star", "type": "circle", "source": "visits", "filter": ["<=", ["get", "m"], -1],
     "paint": {"circle-color": "#FFF4D6",
               "circle-radius": ["*", ["interpolate", ["linear"], ["zoom"], 5, 1.0, 12, 1.8], ["+", 0.8, ["*", 3.2, ["get", "w"]]]],
               "circle-blur": 0.4, "circle-opacity": ["+", 0.35, ["*", 0.65, ["get", "w"]]]}}
  ]
}
