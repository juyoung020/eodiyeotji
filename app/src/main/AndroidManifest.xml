<?xml version="1.0" encoding="utf-8"?>
<!-- 차(car)·폰(phone) 판에 같이 들어가는 것. 판마다 다른 것(차량 기능·Pleos 권한·위치 권한·기록 서비스 종류)은
     src/car/AndroidManifest.xml, src/phone/AndroidManifest.xml 에 있다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== 권한 (앱마켓 심사: 쓰는 것만, 이유와 함께) ===== -->
    <!-- 앱 화면이 없어도 주행 기록을 이어가는 포그라운드 서비스. normal -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 차를 켜면(부팅)·폰을 켜면 앱을 열지 않아도 기록 대기를 시작하기 위해. normal -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 머문 곳·출발/도착 지점을 실제 장소 이름으로 보여 주려고 지도 API(카카오 로컬·OSM)에 좌표를 묻고,
         기억 검색 에이전트·하루 라벨링을 위해 LLM 서버(개발: 개발 PC의 llama-server, res/xml/network_security_config.xml)를 부른다. normal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 표준 음성 인식으로 말로 묻기 (폰은 늘, 차는 Pleos 음성 서비스가 없을 때만). dangerous → 그때 처음 한 번만 묻는다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 오프라인이면 장소 이름 요청을 멈추고, 다시 연결되면 이어서 묻기 위해 연결 상태를 본다. normal -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 표준 음성 인식·음성 합성 엔진을 찾기 위해 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".EodiApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eodiyeotji">

        <!-- screenOrientation 미지정 = Pleos 기본(창 1개, portrait). 창 크기가 바뀌어도 깨지지 않게 화면을 만든다. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 부팅·앱 업데이트 직후 기록 서비스 켜기 (시스템 브로드캐스트만 받는다) -->
        <receiver
            android:name=".record.RecordingBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
