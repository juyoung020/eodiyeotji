<?xml version="1.0" encoding="utf-8"?>
<!-- 차(car) 판 디버그 빌드에만 들어가는 것. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 에뮬레이터에서 adb로 내비 연동 확인 (사용법은 record/NaviDebugReceiver.kt) -->
        <receiver
            android:name=".record.NaviDebugReceiver"
            android:exported="true" />

        <!-- 에뮬레이터에서 adb로 좌석 자세 값 확인 (사용법은 record/SeatDebugReceiver.kt) -->
        <receiver
            android:name=".record.SeatDebugReceiver"
            android:exported="true" />
    </application>

</manifest>
